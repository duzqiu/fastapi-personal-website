# 复制成 .env.development（开发）或 .env.production（生产）后按需修改

# 站点名（导航栏、页脚、浏览器标题都用它）
VITE_APP_TITLE=个人网站

# 前端请求接口的前缀。默认 /api，配合下面的代理走
VITE_API_BASE_URL=/api

# dev / preview 时把 /api 代理到 FastAPI 后端；留空则不代理（前端自己去连 VITE_API_BASE_URL）
VITE_PROXY_TARGET=http://127.0.0.1:8000

# 只展示后端某一个人的简历（后台「个人信息」里的 ID）。
# 留空 = 取后端第一个启用中的人；后端有多个人时建议填上，免得展示错人。
VITE_PROFILE_ID=
